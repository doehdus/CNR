{
  "name": "construction-noise-research-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/backend/*.test.js tests/frontend/*.test.js tests/shared/*.test.js tests/integration/*.test.js",
    "audio:prepare": "node scripts/prepare-audio.mjs",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "pretest": "node scripts/prepare-site.mjs",
    "pretest:frontend": "node scripts/prepare-frontend.mjs",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:backend": "node --test tests/backend/*.test.js",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit --project src/tsconfig.json",
    "typecheck:backend": "tsc --noEmit --project backend/tsconfig.json",
    "pretest:backend": "node scripts/prepare-backend.mjs",
    "test:shared": "node --test tests/shared/*.test.js",
    "pretest:integration": "node scripts/prepare-site.mjs",
    "test:integration": "node --test tests/integration/*.test.js",
    "backend:prepare": "node scripts/prepare-backend.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "pretypecheck": "node scripts/prepare-backend.mjs",
    "pretypecheck:backend": "node scripts/prepare-backend.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "qrcode-generator": "2.0.4",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
