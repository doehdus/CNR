* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.wav binary
*.png binary
# Preserve calculated file bytes so recorded SHA-256 values survive checkout.
experiment/outputs/** -text whitespace=cr-at-eol
# This retained analysis setting participates in byte-level delivery fingerprints.
experiment/config/prefilter_initial.json -text whitespace=cr-at-eol
.githooks/* text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

analysis/results/** -text whitespace=cr-at-eol
analysis/graphs/** -text whitespace=cr-at-eol
data/preparation/** -text whitespace=cr-at-eol
# Processing records fingerprint the input registry byte-for-byte.
data/metadata/inputs.json -text whitespace=cr-at-eol
experiment/** -text whitespace=cr-at-eol
